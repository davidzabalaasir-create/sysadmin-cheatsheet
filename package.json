{
  "name": "sysadmin-cheatsheet",
  "version": "1.9.2",
  "private": true,
  "description": "Sysadmin: biblioteca de comandos para administradores de sistemas (Linux y Windows).",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/src/input.css -o assets/tailwind.css --minify",
    "build:fonts": "node scripts/copy-fonts.js",
    "build": "npm run build:fonts && npm run build:css",
    "validate": "node scripts/validate.js",
    "serve": "node scripts/serve.js 5500",
    "test": "playwright test"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/instrument-serif": "^5.1.0",
    "@playwright/test": "^1.65.0",
    "tailwindcss": "^3.4.17"
  }
}
